# ── Interactive Brokers Gateway ───────────────────────────────────────
# REQUIRED.  Your IBKR account login credentials.
IBKR_USER_ID=your_username
IBKR_PASSWORD=your_password

# Optional.  "paper" (default) or "live".
IBKR_TRADE_MODE=paper

# ── Provider API keys (all optional; without them the screener runs
#    on FROZEN_DEMO research data only) ────────────────────────────────
FINVIZ_API_KEY=
NEWSAPI_KEY=
FINNHUB_KEY=
