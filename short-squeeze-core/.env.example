# Runtime mode. Required for an intentional deployment; restart after changing.
# FROZEN_DEMO is provider-free. CLOUD_PROVIDER_MODE is cloud-safe. LOCAL_FULL is local-only.
SQUEEZE_APP_MODE=FROZEN_DEMO

# HTTP port. Optional; cloud-safe; integer 1-65535; restart after changing.
PORT=8787

# Structured application log level. Optional; cloud-safe; restart after changing.
LOG_LEVEL=INFO

# Finviz Elite export token. Optional; enables scanner fields and Finviz news.
FINVIZ_ENABLED=false
FINVIZ_API_KEY=replace_with_your_finviz_elite_export_token

# NewsAPI key. Optional; enables timestamped display news.
NEWSAPI_ENABLED=false
NEWSAPI_KEY=replace_with_your_newsapi_key

# Finnhub API key. Optional; enables current quote fallback and company news.
FINNHUB_ENABLED=false
FINNHUB_KEY=replace_with_your_finnhub_key

# SEC EDGAR public provider. Optional; no key; a descriptive user agent is required.
SEC_ENABLED=true
SEC_USER_AGENT=YourOrganization/1.0 contact@example.invalid
# Optional separate administrative contact when required by your organization.
SEC_CONTACT_EMAIL=contact@example.invalid

# Local IB Gateway/TWS only. Disabled in cloud and frozen modes.
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=123

# News aggregation configuration
# Comma-separated provider fallback order: Finviz Elite, Finnhub News, NewsAPI
NEWS_PROVIDER_ORDER=Finviz Elite,Finnhub News,NewsAPI
# Per-symbol cache TTL in seconds (60-86400)
NEWS_CACHE_TTL_SECONDS=900
# Maximum headlines retained per symbol after deduplication (1-100)
NEWS_MAX_HEADLINES_PER_SYMBOL=30

# Refresh cadences in seconds. Min quote=5, scanner=30. Provider pacing must be respected.
QUOTE_REFRESH_SECONDS=15
SCANNER_REFRESH_SECONDS=180
# Freshness threshold labels in seconds. Never affect rule outcomes.
FRESHNESS_CURRENT_SECONDS=90
FRESHNESS_DELAYED_SECONDS=600
# Maximum chart data points to return to the frontend.
MAX_CHART_POINTS=400

# Experimental news sentiment. keyword = zero-dependency keyword analysis. finbert = local FinBERT model.
SENTIMENT_ENABLED=true
SENTIMENT_PROVIDER=keyword
# Path to local fine-tuned FinBERT model (only needed if SENTIMENT_PROVIDER=finbert)
SENTIMENT_MODEL_PATH=
# Batch size for headline inference (1-64)
SENTIMENT_BATCH_SIZE=16