# IB Gateway/TWS connection - point this at your own locally-running Gateway and account.
# Defaults match the original single-account setup (paper/live Gateway on its default port);
# override if your Gateway runs on a different port (e.g. 4002 for the default paper-trading
# port, 7497/7496 for TWS) or if you need a distinct client ID to avoid colliding with another
# API client already connected to the same Gateway.
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=7

# Integration snapshots include the built-in FinBERT result by default. Set false when the
# consuming team supplies its own sentiment model; the two sentiment fields will be omitted.
INCLUDE_SENTIMENT_OUTPUT=true

# Discovery-source order, first available wins each cycle (comma-separated). Defaults to
# "ib,schwab,finviz" if left blank - override to reorder/restrict providers per deployment
# without touching code, e.g. "schwab,ib" to prefer Schwab, or "schwab" to use only Schwab.
SCREENER_PROVIDER_PRIORITY=

NEWSAPI_KEY=
FINNHUB_KEY=
FINVIZ_API_KEY=
FINVIZ_USERNAME=
FINVIZ_PASSWORD=
MONGODB_URI=
MONGODB_DB=

# Schwab Trader API (core/schwab_api.py) - from the app you create at developer.schwab.com under
# "Trader API - Individual" (see PROJECT_NOTES.md §7 for the full registration walkthrough).
# Leave blank until the app's Dev Portal status is "Ready For Use"; every function in
# core/schwab_api.py degrades to "not configured"/"not available" until then. Once these are
# set, run `python core/schwab_auth.py` once to complete the one-time OAuth consent flow (repeat
# whenever core/schwab_api.py's health() reports "needs_reauth" - Schwab's refresh tokens
# hard-expire after 7 days).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must exactly match the Callback URL registered on the app (scheme, host, port, trailing slash).
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
